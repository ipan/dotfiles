[user]
    name = Ivan Pan
    email = me@ivanpan.com

[includeIf "hasconfig:remote.*.url:git@github.com:thermofisher/**"]
    path = ~/.gitconfig-thermofisher

[includeIf "hasconfig:remote.*.url:ssh://git@github.com/thermofisher/**"]
    path = ~/.gitconfig-thermofisher

[includeIf "hasconfig:remote.*.url:https://github.com/thermofisher/**"]
    path = ~/.gitconfig-thermofisher

[core]
    editor = nvim
    quotepath = false

[init]
    defaultBranch = main

[fetch]
    prune = true

[diff]
    algorithm = histogram

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[log]
    date = local

[color]
    branch = auto
    diff = auto
    interactive = auto
    status = auto
    ui = true

[alias]
    st = status
    co = checkout
    up = pull --rebase
    mlog = log --no-merges
    ls = log --name-only -- .
    sh = show --name-only
    cp = cherry-pick -x
    cpx = cherry-pick -x -X theirs
    cpm = cherry-pick -x -m 1

[push]
    default = simple
    autosetupremote = true

[pull]
    rebase = false

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge --skip -- %f
    required = true
    process = git-lfs filter-process --skip

[url "git@github-thermofisher:thermofisher/"]
    insteadOf = git@github.com:thermofisher/

[url "ssh://git@github-thermofisher/thermofisher/"]
    insteadOf = ssh://git@github.com/thermofisher/
